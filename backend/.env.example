# Anthropic API key — get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for answer generation
ANTHROPIC_MODEL=claude-opus-4-8

# Where ChromaDB persists the vector index
CHROMA_DIR=./chroma_data

# Chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Number of chunks retrieved per question
TOP_K=5

# Minimum relevance score (0-1) for a chunk to be sent to the LLM
MIN_RELEVANCE=0.3

# Answer mode:
#   auto       - use the LLM, fall back to extractive passages if it fails
#   llm        - LLM only; surface errors
#   extractive - never call an LLM; return top passages (fully free)
ANSWER_MODE=auto

# LLM provider for answer generation:
#   anthropic - Claude API (needs ANTHROPIC_API_KEY + credits; best quality)
#   ollama    - local open-weights model via Ollama (free, runs on-device)
#   gemini    - Google Gemini API free tier (needs GOOGLE_API_KEY)
LLM_PROVIDER=anthropic
OLLAMA_MODEL=llama3.2
GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=...

# Deployment-only settings
# FRONTEND_ORIGIN=https://your-app.vercel.app
# SEED_SAMPLES_IF_EMPTY=true
